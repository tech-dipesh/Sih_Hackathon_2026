generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto]
}

enum VendorStatus {
  pending
  active
  suspended
  rejected
}

enum VerificationDecision {
  pending
  cleared
  rejected
}

enum PaymentMethod {
  upi
  cash
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum OrderStatus {
  placed
  accepted
  rejected
  fulfilled
  cancelled
}
model Station {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  state     String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  checkIns VendorCheckIn[]
  orders   Order[]

  @@index([state])
}

model Vendor {
  id          String       @id @default(cuid())
  name        String
  phone       String       @unique
  phoneVerifiedAt DateTime?
  category    String
  upiId       String
  status      VendorStatus @default(pending)
  soldOut     Boolean      @default(false)
  passwordHash String?
  qrToken     String       @unique @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  verification VendorVerification?
  checkIns     VendorCheckIn[]
  catalogItems CatalogItem[]
  orders       Order[]

  @@index([status])
  @@index([category])
}

model VendorVerification {
  id                  String               @id @default(cuid())
  vendorId            String               @unique
  vendor              Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  aadhaarHash         String
  photoFingerprint    String?
  selfieMatchPassed   Boolean?
  decision            VerificationDecision @default(pending)
  reviewedByAdminId   String?
  decidedAt           DateTime?
  createdAt           DateTime             @default(now())

  @@index([aadhaarHash])
  @@index([decision])
}

model VendorCheckIn {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  stationId   String
  station     Station   @relation(fields: [stationId], references: [id])
  platform    String
  checkedInAt DateTime  @default(now())
  expiresAt   DateTime
  checkedOutAt DateTime?

  @@index([stationId, expiresAt])
  @@index([vendorId])
}

model CatalogItem {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  priceInPaise Int
  createdAt DateTime @default(now())

  orderItems OrderItem[]

  @@index([vendorId])
}

model Customer {
  id              String    @id @default(cuid())
  phone           String    @unique
  phoneVerifiedAt DateTime?
  email           String?   @unique
  passwordHash    String?
  createdAt       DateTime  @default(now())

  orders Order[]
}

model Order {
  id              String        @id @default(cuid())
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  guestPhone      String?
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  stationId       String
  station         Station       @relation(fields: [stationId], references: [id])
  totalInPaise    Int
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(pending)
  upiTransactionRef String?
  status          OrderStatus   @default(placed)
  placedAt        DateTime      @default(now())
  acceptedAt      DateTime?
  fulfilledAt     DateTime?

  items      OrderItem[]

  @@index([vendorId, status])
  @@index([customerId])
}

model OrderItem {
  id              String      @id @default(cuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItemId   String
  catalogItem     CatalogItem @relation(fields: [catalogItemId], references: [id])
  quantity        Int
  priceAtOrderTimeInPaise Int

  @@index([orderId])
}
