generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto]
}

enum VendorStatus {
  pending
  active
  suspended
  rejected
}

enum VerificationDecision {
  pending
  cleared
  rejected
}
model Station {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  state     String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  checkIns VendorCheckIn[]

  @@index([state])
}

model Vendor {
  id          String       @id @default(cuid())
  name        String
  phone       String       @unique
  phoneVerifiedAt DateTime?
  category    String
  upiId       String
  status      VendorStatus @default(pending)
  soldOut     Boolean      @default(false)
  passwordHash String?
  qrToken     String       @unique @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  verification VendorVerification?
  checkIns     VendorCheckIn[]
  catalogItems CatalogItem[]
 
  @@index([status])
  @@index([category])
}

model VendorVerification {
  id                  String               @id @default(cuid())
  vendorId            String               @unique
  vendor              Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  aadhaarHash         String
  photoFingerprint    String?
  selfieMatchPassed   Boolean?
  decision            VerificationDecision @default(pending)
  reviewedByAdminId   String?
  decidedAt           DateTime?
  createdAt           DateTime             @default(now())

  @@index([aadhaarHash])
  @@index([decision])
}

model VendorCheckIn {
  id          String    @id @default(cuid())
  vendorId    String
  vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  stationId   String
  station     Station   @relation(fields: [stationId], references: [id])
  platform    String
  checkedInAt DateTime  @default(now())
  expiresAt   DateTime
  checkedOutAt DateTime?

  @@index([stationId, expiresAt])
  @@index([vendorId])
}
