{
  "name": "railvendor",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --recursive --filter ./apps/* build",
    "lint": "pnpm --recursive lint",
    "type": "pnpm --recursive type",
    "generate": "pnpm --filter @railvendor/shared generate",
    "migrate": "pnpm --filter @railvendor/shared migrate"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "^22.10.0"
  },
  "packageManager": "pnpm@9.15.0"
}
